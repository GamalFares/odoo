[options]
; Database settings - using environment variables
db_host = ${DB_HOST}
db_port = ${DB_PORT}
db_user = ${DB_USER}
db_password = ${DB_PASSWORD}
db_name = ${DB_NAME}

; Security settings
admin_passwd = ${ADMIN_PASSWORD}
without_demo = all
proxy_mode = True

; Performance settings
workers = 2
limit_memory_soft = 402653184
limit_memory_hard = 536870912
limit_time_cpu = 60
limit_time_real = 120
max_cron_threads = 1

; HTTP settings
http_interface = 0.0.0.0
http_port = ${PORT}
data_dir = /tmp/odoo-data
